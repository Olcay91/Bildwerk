<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Sprachen der App: macOS zeigt eigene Menüpunkte (z. B. „Emoji & Symbole“) und
       Systemdialoge (Öffnen/Sichern) dann in der Systemsprache statt immer auf Englisch -->
  <key>CFBundleLocalizations</key>
  <array>
    <string>de</string>
    <string>en</string>
  </array>
  <key>CFBundleAllowMixedLocalizations</key>
  <true/>
</dict>
</plist>
